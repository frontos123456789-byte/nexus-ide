# Required for AI features (server-side only). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the OpenRouter API base (e.g. the local mock: node scripts/mock-openrouter.mjs)
# OPENROUTER_BASE_URL=http://127.0.0.1:4010/v1

# Optional: only checked by /api/health when set
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app_db

# ---- Nexus Features (server-side only) ----
# Required in production to enable privileged tools (DB, API proxy, deploy, Docker, Figma, Git, env check).
# Without it these routes are disabled in production. Enter the same value in Nexus Features → Settings.
NEXUS_ADMIN_KEY=
# Optional integrations
# VERCEL_TOKEN=            # Preview Deploy
# GITHUB_TOKEN=            # Git Timeline (private repos / higher rate limit)
# NEXUS_GITHUB_REPO=owner/name
# FIGMA_TOKEN=             # Figma Sync
# NEXUS_DATABASE_URL=      # Database Explorer (falls back to DATABASE_URL)
# NEXUS_DB_READONLY=1      # forbid all writes through the explorer
# NEXUS_DOCKER=1           # enable Docker manager (needs docker socket)

# ---- Nexus V2 (server-side only) ----
# Web search (optional; without keys DuckDuckGo HTML + Wikipedia are used)
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# JS-rendering browser service for the web tool (optional, e.g. Browserless)
# BROWSERLESS_URL=
# BROWSERLESS_TOKEN=
# Encryption key for integration sessions (GitHub/Vercel/Telegram tokens in httpOnly cookies)
# NEXUS_SESSION_SECRET=
# GitHub webhook receiver: POST /api/webhooks/github (HMAC-SHA256 verified)
# GITHUB_WEBHOOK_SECRET=
# Owner-mode tokens (also require NEXUS_ADMIN_KEY header): GITHUB_TOKEN, VERCEL_TOKEN, TELEGRAM_BOT_TOKEN

# ---- Accounts & OAuth (see docs/OAUTH_SETUP.md) ----
# Public HTTPS origin of Nexus (pins OAuth callback URLs; prevents Host-header spoofing)
# NEXUS_BASE_URL=https://your-domain
# REQUIRED in production – encrypts provider tokens (openssl rand -base64 32). Old key for rotation: NEXUS_ENCRYPTION_KEY_PREVIOUS
# NEXUS_ENCRYPTION_KEY=
# GitHub login: either a classic OAuth App ...
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# ... and/or the GitHub App (needed for repository access)
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=        # PEM with \n escapes, or base64 of the PEM
# GITHUB_APP_WEBHOOK_SECRET=
# Sign in with Vercel (identity only)
# VERCEL_APP_CLIENT_ID=
# VERCEL_APP_CLIENT_SECRET=
# Vercel Integration (REST API access: projects, deployments, env)
# VERCEL_INTEGRATION_SLUG=
# VERCEL_INTEGRATION_CLIENT_ID=
# VERCEL_INTEGRATION_CLIENT_SECRET=

# ---- Vercel Monitor (read-only integration; see docs/VERCEL_MONITOR_SETUP.md) ----
# A SEPARATE Vercel Integration registered with Projects: Read + Deployments: Read only.
# VERCEL_MONITOR_CLIENT_ID=
# VERCEL_MONITOR_CLIENT_SECRET=
# VERCEL_MONITOR_SLUG=
